<Window x:Class="ZCompare.App.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="差异详情"
        Width="760"
        Height="560"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#93C5FD" BorderThickness="1">
            <ScrollViewer AutomationProperties.Name="完整差异详情"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DetailsTextBlock"
                           Padding="10"
                           FontFamily="Consolas"
                           FontSize="13"
                           TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="88" Margin="0,0,8,0" Click="CopyButton_OnClick" Content="复制全部" />
            <Button Width="88" IsCancel="True" Content="关闭" />
        </StackPanel>
    </Grid>
</Window>
