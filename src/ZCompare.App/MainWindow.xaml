<Window x:Class="ZCompare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ZCompare — XLSX 对比工具"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172554">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White" Text="ZCompare" />
                    <TextBlock FontSize="10" Foreground="#BFDBFE" Text="只读 XLSX 语义对比" />
                </StackPanel>
                <Grid Grid.Column="1" Margin="0,4,16,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#DBEAFE"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusText}" />
                    <DockPanel Grid.Row="1" VerticalAlignment="Center" LastChildFill="True">
                        <TextBlock Margin="0,0,6,0" Foreground="#93C5FD" Text="当前文件：" />
                        <TextBlock Foreground="White"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentProgressFileName}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentProgressItem}" />
                    </DockPanel>
                </Grid>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="#DBEAFE"
                           Text="{Binding OperationElapsedText}" />
                <ProgressBar Grid.Column="3"
                             Width="180"
                             Height="6"
                             HorizontalAlignment="Right"
                             Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding ProgressIsIndeterminate}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <Border x:Name="UpdateBanner"
                Grid.Row="1"
                Padding="12,7"
                Background="#EFF6FF"
                BorderBrush="#93C5FD"
                BorderThickness="0,0,0,1"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="8,0,0,0"
                            Click="DownloadUpdateButton_OnClick"
                            Content="一键下载"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Margin="0"
                            Click="DismissUpdateButton_OnClick"
                            Content="稍后"
                            Style="{StaticResource ToolbarButtonStyle}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           Text="{Binding Message}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Margin="8,6,8,6" Padding="8" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" Padding="2" Background="#E8EEF7" CornerRadius="7" IsEnabled="{Binding CanEditInputs}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="文件对比" IsChecked="{Binding IsFileMode, Mode=TwoWay}" Style="{StaticResource ModeToggleStyle}" />
                        <RadioButton Content="文件夹对比" IsChecked="{Binding IsFolderMode, Mode=TwoWay}" Style="{StaticResource ModeToggleStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="1"
                        MinHeight="40"
                        Padding="8,3"
                        AllowDrop="True"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        IsEnabled="{Binding CanEditInputs}"
                        Tag="Left"
                        PreviewDragOver="PathPanel_OnPreviewDragOver"
                        Drop="PathPanel_OnDrop">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" Margin="0,0,6,0" Background="#DBEAFE" CornerRadius="13">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1D4ED8" Text="左" />
                        </Border>
                        <TextBox Grid.Column="1" AutomationProperties.Name="左侧路径" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Margin="6,0,0,0" Command="{Binding BrowseCommand}" CommandParameter="Left" Content="浏览…" Style="{StaticResource ToolbarButtonStyle}" />
                    </Grid>
                </Border>

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Width="34"
                        Height="34"
                        Margin="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{Binding SwapCommand}"
                        Content="⇄"
                        FontSize="17"
                        Padding="0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="交换左右两侧" />

                <Border Grid.Row="0"
                        Grid.Column="3"
                        MinHeight="40"
                        Padding="8,3"
                        AllowDrop="True"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        IsEnabled="{Binding CanEditInputs}"
                        Tag="Right"
                        PreviewDragOver="PathPanel_OnPreviewDragOver"
                        Drop="PathPanel_OnDrop">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" Margin="0,0,6,0" Background="#E0E7FF" CornerRadius="13">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#4338CA" Text="右" />
                        </Border>
                        <TextBox Grid.Column="1" AutomationProperties.Name="右侧路径" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Margin="6,0,0,0" Command="{Binding BrowseCommand}" CommandParameter="Right" Content="浏览…" Style="{StaticResource ToolbarButtonStyle}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="0" Grid.Column="4" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding StartCommand}" Content="{Binding PrimaryActionText}" Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Command="{Binding CancelCommand}" Content="取消" Style="{StaticResource ToolbarButtonStyle}" />
                    <Button Command="{Binding RefreshCommand}" Content="刷新" Style="{StaticResource ToolbarButtonStyle}" />
                    <Button Click="ExportReportButton_OnClick"
                            Content="导出报告"
                            IsEnabled="{Binding CanExportReport}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="导出当前工作簿或文件夹比较结果（JSON/XLSX）" />
                </StackPanel>

                <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,6,0,0" IsEnabled="{Binding CanEditInputs}" ToolTip="默认仅比较保存值并区分大小写；公式缓存结果与安全警告始终比较。">
                    <TextBlock Margin="0,0,6,3" VerticalAlignment="Center" FontWeight="SemiBold" Text="最近对比" />
                    <ComboBox Width="260"
                              Margin="0,0,10,3"
                              VerticalContentAlignment="Center"
                              AutomationProperties.Name="最近对比"
                              ItemsSource="{Binding RecentComparisons}"
                              MaxDropDownHeight="360"
                              SelectedItem="{Binding SelectedRecentComparison, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock MaxWidth="480" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolTipText}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Margin="0,0,10,3"
                            Click="SaveProfileButton_OnClick"
                            Content="保存配置"
                            IsEnabled="{Binding CanSaveProfile}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="保存路径和全部比较选项；保存后不会自动运行" />
                    <Button Margin="0,0,10,3"
                            Click="WorksheetSettingsButton_OnClick"
                            Content="工作表/行列…"
                            IsEnabled="{Binding CanEditInputs}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="{Binding WorksheetSettingsSummary}" />
                    <CheckBox Margin="0,0,10,3" VerticalAlignment="Center" Content="比对公式" IsChecked="{Binding CompareFormulas}" />
                    <CheckBox Margin="0,0,10,3" VerticalAlignment="Center" Content="比对格式" IsChecked="{Binding CompareFormatting}" ToolTip="数字格式、填充、边框和对齐" />
                    <CheckBox Margin="0,0,10,3" VerticalAlignment="Center" Content="比对字体" IsChecked="{Binding CompareFonts}" />
                    <CheckBox Margin="0,0,10,3" VerticalAlignment="Center" Content="比对批注" IsChecked="{Binding CompareComments}" />
                    <CheckBox Margin="0,0,10,3" VerticalAlignment="Center" Content="比对链接" IsChecked="{Binding CompareHyperlinks}" />
                    <CheckBox Margin="0,0,10,3" VerticalAlignment="Center" Content="比对布局" IsChecked="{Binding CompareLayout}" ToolTip="工作表顺序和可见性、合并区域、隐藏行列及未比较对象" />
                    <CheckBox Margin="0,0,10,3" VerticalAlignment="Center" Content="区分大小写" IsChecked="{Binding CaseSensitive}" />
                    <CheckBox Margin="0,0,10,3"
                              VerticalAlignment="Center"
                              Content="严格按原行号对比"
                              IsChecked="{Binding StrictRowNumberComparison}"
                              ToolTip="默认关闭：保守对齐插入/删除行；开启后按工作表原始行号逐行比较。" />
                    <CheckBox Margin="0,0,10,3"
                              VerticalAlignment="Center"
                              Content="包含子目录"
                              IsChecked="{Binding IncludeSubdirectories}"
                              Visibility="{Binding IsFolderMode, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Margin="0,0,10,3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsFolderMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="文件通配符" />
                        <TextBox Width="110"
                                 Padding="6,2"
                                 AutomationProperties.Name="文件通配符"
                                 Text="{Binding FolderFilePattern, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如 *.xlsx" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="8,0,8,6">
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding ShowStartHint, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="72" Height="72" Background="#EFF6FF" CornerRadius="36">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" Foreground="{StaticResource PrimaryBrush}" Text="≠" />
                    </Border>
                    <TextBlock Margin="0,18,0,6" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="选择两个 XLSX 文件开始比较" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="默认只比较保存值并区分大小写；六类高级差异可分别开启。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding ShowFolderResults, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="文件夹对齐结果" />
                                <Button Click="SelectAllFolderRows_OnClick" Content="全选" IsEnabled="{Binding CanEditInputs}" Style="{StaticResource ToolbarButtonStyle}" />
                                <Button Command="{Binding CompareSelectedCommand}" Content="对比" Style="{StaticResource PrimaryButtonStyle}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding FolderSelectionSummary}" />
                            </StackPanel>
                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="选择一个或多个成对文件后点击“对比”；完成后双击行查看详情。" />
                        </StackPanel>
                        <TextBox x:Name="FolderSearchBox"
                                 Grid.Column="1"
                                 Width="220"
                                 Height="32"
                                 Margin="10,0,0,0"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 ToolTip="按相对路径筛选；清空后显示当前范围内的全部文件"
                                 Text="{Binding FolderSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Border Grid.Column="2" Margin="10,0" Padding="3" Background="#E8EEF7" CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="全部" IsChecked="{Binding ShowAllFolderFiles, Mode=TwoWay}" Style="{StaticResource ModeToggleStyle}" Padding="12,6" />
                                <RadioButton Content="差异" IsChecked="{Binding ShowFolderDifferencesOnly, Mode=TwoWay}" Style="{StaticResource ModeToggleStyle}" Padding="12,6" Tag="Difference" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid x:Name="FolderResultGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              IsEnabled="{Binding CanEditInputs}"
                              IsReadOnly="True"
                              ItemsSource="{Binding FolderFilesView}"
                              KeyDown="FolderResultGrid_OnKeyDown"
                              MouseDoubleClick="FolderResultGrid_OnMouseDoubleClick"
                              RowHeight="42"
                              ColumnHeaderHeight="30"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="{StaticResource LineBrush}"
                              VerticalGridLinesBrush="{StaticResource LineBrush}"
                              SelectedItem="{Binding FocusedFolderFile, Mode=TwoWay}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" Header="选">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="加入对比"
                                                  IsChecked="{Binding IsMarkedForComparison, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="勾选后点击“对比”" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="2*" Binding="{Binding LeftDisplayPath}" Header="左侧文件">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding LeftFileBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="8,0" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding LeftPath}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="92" Binding="{Binding LeftSize}" Header="大小">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding LeftFileBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="4,0,8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="148" Binding="{Binding LeftModified}" Header="修改时间">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding LeftFileBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="180" Header="状态 / 原因">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="6" Padding="5,2" Background="{Binding StatusBackground}" CornerRadius="12" ToolTip="{Binding StatusToolTip}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{Binding StatusBrush}" Text="{Binding StatusSymbol}" />
                                                    <TextBlock Margin="5,0,0,0" Foreground="{Binding StatusBrush}" Text="{Binding DifferenceCount}" />
                                                </StackPanel>
                                                <TextBlock MaxWidth="154"
                                                           Margin="0,1,0,0"
                                                           FontSize="10"
                                                           Foreground="{Binding StatusBrush}"
                                                           Text="{Binding IssueSummary}"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasIssueDetails, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="2*" Binding="{Binding RightDisplayPath}" Header="右侧文件">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding RightFileBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="8,0" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding RightPath}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="92" Binding="{Binding RightSize}" Header="大小">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding RightFileBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="4,0,8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="148" Binding="{Binding RightModified}" Header="修改时间">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding RightFileBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Visibility="{Binding IsWorkbookOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="6,4" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7,7,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" LastChildFill="True">
                            <Button Margin="0,0,6,0"
                                    DockPanel.Dock="Left"
                                    Command="{Binding BackToFolderCommand}"
                                    Content="← 返回列表"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Visibility="{Binding IsFolderMode, Converter={StaticResource BoolToVisibility}}" />
                            <Border Margin="0,0,8,0" Padding="2" DockPanel.Dock="Left" Background="#E8EEF7" CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="全部" IsChecked="{Binding ShowAllWorkbookRows, Mode=TwoWay}" Style="{StaticResource ModeToggleStyle}" Padding="9,4" />
                                    <RadioButton Content="差异" IsChecked="{Binding ShowWorkbookDifferencesOnly, Mode=TwoWay}" Style="{StaticResource ModeToggleStyle}" Padding="9,4" Tag="Difference" />
                                </StackPanel>
                            </Border>
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#1D4ED8"
                                       Text="{Binding CurrentLeftFileName}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CurrentLeftFileName}" />
                        </DockPanel>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="↔" />
                        <DockPanel Grid.Column="2" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Click="OtherDetailsButton_OnClick"
                                    Content="其他详情"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Visibility="{Binding HasOtherDetails, Converter={StaticResource BoolToVisibility}}" />
                            <Button Click="SelectedCellDetailsButton_OnClick"
                                    Content="完整值"
                                    IsEnabled="{Binding HasSelectedCell}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    ToolTip="查看当前单元格左右完整原始值、显示值和字符差异" />
                            <Button Command="{Binding PreviousDifferenceCommand}" Content="↑ 上一处" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Command="{Binding NextDifferenceCommand}" Content="↓ 下一处" Style="{StaticResource ToolbarButtonStyle}" />
                            </StackPanel>
                            <TextBlock Margin="6,0,8,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#4338CA"
                                       Text="{Binding CurrentRightFileName}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CurrentRightFileName}" />
                        </DockPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="6,2" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,1,1">
                    <DockPanel>
                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Sheet：" />
                        <ListBox ItemsSource="{Binding Worksheets}"
                                 SelectedItem="{Binding SelectedWorksheet}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel IsItemsHost="True" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,4" />
                                    <Setter Property="Margin" Value="0,0,4,0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
                                                    <TextBlock Text="{Binding Header}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#DBEAFE" />
                                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#60A5FA" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding HasDifferences}" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#FEE2E2" />
                                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#F87171" />
                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasDifferences}" Value="True" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#FECACA" />
                                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#DC2626" />
                                                        <Setter TargetName="TabBorder" Property="BorderThickness" Value="2" />
                                                        <Setter Property="Foreground" Value="#991B1B" />
                                                    </MultiDataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="2" Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Padding="6,4" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,1,1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Width="54" FontWeight="SemiBold" Text="公式栏" />
                                <TextBox IsReadOnly="True" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" HorizontalScrollBarVisibility="Auto" Text="{Binding LeftSelectedFormula, Mode=OneWay}" ToolTip="{Binding LeftSelectedFormula}" />
                            </DockPanel>
                            <Grid Grid.Row="1" Margin="54,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="原始值" />
                                <TextBox Grid.Column="1" Margin="0,0,8,0" Padding="3,1" IsReadOnly="True" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" HorizontalScrollBarVisibility="Auto" Text="{Binding LeftSelectedRaw, Mode=OneWay}" TextWrapping="NoWrap" ToolTip="{Binding LeftSelectedRaw}" />
                                <TextBlock Grid.Column="2" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="显示值" />
                                <TextBox Grid.Column="3" Padding="3,1" IsReadOnly="True" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" HorizontalScrollBarVisibility="Auto" Text="{Binding LeftSelectedDisplay, Mode=OneWay}" TextWrapping="NoWrap" ToolTip="{Binding LeftSelectedDisplay}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#E2E8F0"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#64748B" Text="{Binding SelectedAddress}" TextAlignment="Center" TextWrapping="Wrap" /></Border>
                    <Border Grid.Column="2" Padding="6,4" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,1,1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Width="54" FontWeight="SemiBold" Text="公式栏" />
                                <TextBox IsReadOnly="True" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" HorizontalScrollBarVisibility="Auto" Text="{Binding RightSelectedFormula, Mode=OneWay}" ToolTip="{Binding RightSelectedFormula}" />
                            </DockPanel>
                            <Grid Grid.Row="1" Margin="54,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="原始值" />
                                <TextBox Grid.Column="1" Margin="0,0,8,0" Padding="3,1" IsReadOnly="True" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" HorizontalScrollBarVisibility="Auto" Text="{Binding RightSelectedRaw, Mode=OneWay}" TextWrapping="NoWrap" ToolTip="{Binding RightSelectedRaw}" />
                                <TextBlock Grid.Column="2" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="显示值" />
                                <TextBox Grid.Column="3" Padding="3,1" IsReadOnly="True" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" HorizontalScrollBarVisibility="Auto" Text="{Binding RightSelectedDisplay, Mode=OneWay}" TextWrapping="NoWrap" ToolTip="{Binding RightSelectedDisplay}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <DataGrid x:Name="LeftGrid"
                              Grid.Column="0"
                              ItemsSource="{Binding GridViewport.LeftRows}"
                              CurrentCellChanged="SpreadsheetGrid_OnCurrentCellChanged"
                              KeyDown="SpreadsheetGrid_OnKeyDown"
                              MouseDoubleClick="SpreadsheetGrid_OnMouseDoubleClick"
                              Loaded="SpreadsheetGrid_OnLoaded"
                              ScrollViewer.ScrollChanged="SpreadsheetGrid_OnScrollChanged"
                              Style="{StaticResource SpreadsheetGridStyle}">
                        <DataGrid.RowHeaderTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding RowHeader}" ToolTip="{Binding AlignmentMessage}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGrid.RowHeaderTemplate>
                    </DataGrid>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CBD5E1" ResizeDirection="Columns" />
                    <DataGrid x:Name="RightGrid"
                              Grid.Column="2"
                              ItemsSource="{Binding GridViewport.RightRows}"
                              CurrentCellChanged="SpreadsheetGrid_OnCurrentCellChanged"
                              KeyDown="SpreadsheetGrid_OnKeyDown"
                              MouseDoubleClick="SpreadsheetGrid_OnMouseDoubleClick"
                              Loaded="SpreadsheetGrid_OnLoaded"
                              ScrollViewer.ScrollChanged="SpreadsheetGrid_OnScrollChanged"
                              Style="{StaticResource SpreadsheetGridStyle}">
                        <DataGrid.RowHeaderTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding RowHeader}" ToolTip="{Binding AlignmentMessage}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGrid.RowHeaderTemplate>
                    </DataGrid>
                    <Grid Grid.ColumnSpan="3"
                          Panel.ZIndex="10"
                          Background="#80FFFFFF"
                          IsHitTestVisible="False"
                          Visibility="{Binding IsPreviewBusy, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="46"
                                     Height="46"
                                     Stroke="{StaticResource PrimaryBrush}"
                                     StrokeThickness="5"
                                     StrokeDashArray="1,1.8"
                                     StrokeStartLineCap="Round"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform />
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewBusy}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="PreviewLoadingStoryboard">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:0.8"
                                                                             RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="PreviewLoadingStoryboard" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource PrimaryDarkBrush}" Text="正在加载工作表…" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Background="#E8EEF7" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StatusText}" />
                <TextBlock Grid.Column="1" MaxWidth="620" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" Text="{Binding WarningText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WarningText}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
